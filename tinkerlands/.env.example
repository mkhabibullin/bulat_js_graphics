# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.

# Public domain name. Its DNS must point at this machine for HTTPS to work.
DOMAIN=play.example.com

# Generate each with: openssl rand -hex 32
ADMIN_TOKEN=
METRICS_TOKEN=

# Optional
# LOG_LEVEL=info
# BLOCKED_WORDS=extra,words,to,filter
