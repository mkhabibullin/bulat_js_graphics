{
  "name": "tinkerlands",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer block-world sandbox: build worlds, publish them, play together in the browser.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --disable-warning=ExperimentalWarning e2e/smoke.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.0.0",
    "three": "^0.170.0",
    "typescript": "^5.8.0"
  }
}
